generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Cliente {
  clienteId              Int                 @id @default(autoincrement())
  fechaCreacion          DateTime            @default(now())
  estado                 String
  rut                    String              @unique
  razonSocial            String
  nombreCliente          String
  pais                   String
  region                 String
  ciudad                 String
  comuna                 String
  direccion              String
  telefono               String?
  sitioWeb               String?
  segmento               String?
  industria              String?
  giro                   String?
  emailFacturacion       String[]
  otroRut                String?
  representanteLegal     String?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  agendas                Agenda[]
  clientesContactos      ClienteContacto[]
  condicionesComerciales CondicionComercial?
  cotizaciones           Cotizacion[]
  rcms                   RCM[]
  solicitudes            Solicitud[]
}

model Contacto {
  nombre            String
  email             String
  telefono1         String
  telefono2         String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  contactId         Int               @id @default(autoincrement())
  comuna            String?
  direccion         String?
  empresa           String?
  cargo             String            @default("Sin cargo")
  estado            String            @default("ACTIVO")
  clientesContactos ClienteContacto[]
  contactosObra     ContactoObra[]
  Cotizacion        Cotizacion[]
}

model CondicionComercial {
  id             Int     @id @default(autoincrement())
  vendedor       String
  condicionVenta String
  observaciones  String?
  clienteId      Int     @unique
  cliente        Cliente @relation(fields: [clienteId], references: [clienteId])
}

model User {
  id             String           @id @default(cuid())
  name           String?
  email          String?          @unique
  password       String?
  emailVerified  DateTime?
  image          String?
  accounts       Account[]
  agendas        AgendaAsignado[]
  ordenesTrabajo OrdenTrabajo[]
  sessions       Session[]
  roles          UserRol[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ClienteContacto {
  id          Int      @id @default(autoincrement())
  clienteId   Int
  contactId   Int
  cargo       String
  nombre      String   @default("")
  email       String   @default("")
  telefono1   String   @default("")
  telefono2   String?
  isPrincipal Boolean  @default(false)
  createdAt   DateTime @default(now())
  cliente     Cliente  @relation(fields: [clienteId], references: [clienteId])
  contacto    Contacto @relation(fields: [contactId], references: [contactId])

  @@unique([clienteId, contactId])
}

model Producto {
  productoId            Int                   @id @default(autoincrement())
  sku                   String                @unique
  nombre                String
  descripcion           String?
  area                  String?
  familia               String?
  esPaquete             Boolean               @default(false)
  tipo                  String
  precio                Decimal?              @db.Decimal(10, 2)
  estado                EstadoProducto        @default(ACTIVO)
  norma                 String?
  aplicaImpuesto        Boolean               @default(true)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  detallesCotizacion    DetalleCotizacion[]
  listasPrecios         ProductoListaPrecio[]
  productosEnPaquete    ProductoPaquete[]     @relation("PaqueteProductos")
  paquetesQueLoIncluyen ProductoPaquete[]     @relation("ProductoEnPaquetes")
  serviciosMuestra      ServicioMuestra[]
  serviciosRCM          ServicioRCM[]

  @@index([sku])
  @@index([estado])
  @@index([familia])
  @@index([area])
}

model ProductoPaquete {
  id             Int      @id @default(autoincrement())
  paqueteId      Int
  productoId     Int
  cantidad       Int      @default(1)
  descripcion    String?
  precioUnitario Decimal? @db.Decimal(10, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  paquete        Producto @relation("PaqueteProductos", fields: [paqueteId], references: [productoId])
  producto       Producto @relation("ProductoEnPaquetes", fields: [productoId], references: [productoId])

  @@unique([paqueteId, productoId])
  @@index([paqueteId])
  @@index([productoId])
}

model Obra {
  obraId                   Int            @id @default(autoincrement())
  numeroObra               String
  fechaIngreso             DateTime
  estado                   String         @default("activo")
  estadoObra               String
  rut                      String
  nombreCliente            String
  razonSocial              String?
  nombreObra               String
  direccion                String
  region                   String
  comuna                   String
  sector                   String?
  georreferencia           String?
  referencia               String?
  mandante                 String?
  informeMandante          Boolean        @default(false)
  textoMandante            String?
  giro                     String?
  direccionComercial       String?
  comunaFacturacion        String?
  telefonoFacturacion      String?
  listaPrecios             String?
  mailRecepcionFactura     String[]
  correos                  String[]
  acreditacionPersonal     Boolean        @default(false)
  especificacionesTecnicas Boolean        @default(false)
  acreditacionEquipos      Boolean        @default(false)
  cartaCompromiso          Boolean        @default(false)
  mandatoServiu            Boolean        @default(false)
  otrosRequisitos          String?
  estadoPago               Boolean        @default(false)
  hes                      Boolean        @default(false)
  oc                       Boolean        @default(false)
  otrasReferencias         String?
  envioInformes            Boolean        @default(false)
  representanteLegal       String?
  rutRepresentanteLegal    String?
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt
  agendas                  Agenda[]
  contactos                ContactoObra[]
  cotizaciones             Cotizacion[]
  rcms                     RCM[]
  solicitudes              Solicitud[]
}

model ContactoObra {
  id          Int       @id @default(autoincrement())
  nombre      String
  rol         String
  email       String?
  telefono1   String?
  telefono2   String?
  isPrincipal Boolean   @default(false)
  obraId      Int
  contactId   Int?
  contacto    Contacto? @relation(fields: [contactId], references: [contactId])
  obra        Obra      @relation(fields: [obraId], references: [obraId])
}

model Permission {
  id          String   @id @default(cuid())
  name        String   @unique
  assignedTo  String[]
  createdDate DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Region {
  id        Int      @id @default(autoincrement())
  codigo    String   @unique
  nombre    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  comunas   Comuna[]
}

model Comuna {
  id        Int      @id @default(autoincrement())
  codigo    String   @unique
  nombre    String
  regionId  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  region    Region   @relation(fields: [regionId], references: [id])

  @@index([regionId])
}

model ListaPrecio {
  id        Int                   @id @default(autoincrement())
  nombre    String
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt
  productos ProductoListaPrecio[]
  cotizaciones Cotizacion[]
}

model ProductoListaPrecio {
  id            Int         @id @default(autoincrement())
  productoId    Int
  listaPrecioId Int
  precio        Decimal?    @db.Decimal(10, 2)
  activo        Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  listaPrecio   ListaPrecio @relation(fields: [listaPrecioId], references: [id])
  producto      Producto    @relation(fields: [productoId], references: [productoId])

  @@unique([productoId, listaPrecioId])
}

model Cotizacion {
  id               Int                 @id @default(autoincrement())
  numeroCotizacion String
  tipoCotizacion   TipoCotizacion      @default(A)
  fechaCreacion    DateTime            @default(now())
  fechaInicio      DateTime
  fechaFin         DateTime
  estado           EstadoCotizacion    @default(BORRADOR)
  nombreProyecto   String?
  empresa          String?
  ubicacion        String?
  clienteId        Int?
  obraId           Int?
  vendedorId       String?
  observaciones    String?
  observacionGestion String?
  subtotal         Decimal             @db.Decimal(10, 2)
  descuento        Decimal             @db.Decimal(10, 2)
  impuesto         Decimal             @db.Decimal(10, 2)
  total            Decimal             @db.Decimal(10, 2)
  contactId        Int?
  listaPrecioId    Int?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  formaPago        String?
  cliente          Cliente?            @relation(fields: [clienteId], references: [clienteId])
  contacto         Contacto?           @relation(fields: [contactId], references: [contactId], map: "Cotizacion_contactoId_fkey")
  obra             Obra?               @relation(fields: [obraId], references: [obraId])
  listaPrecio      ListaPrecio?        @relation(fields: [listaPrecioId], references: [id])
  detalles         DetalleCotizacion[]
  solicitudes      Solicitud[]

  @@index([contactId], map: "Cotizacion_contactoId_idx")
  @@index([listaPrecioId])
}

model DetalleCotizacion {
  id             Int                 @id @default(autoincrement())
  cotizacionId   Int
  productoId     Int
  cantidad       Int
  precioUnitario Decimal             @db.Decimal(10, 2)
  descuento      Decimal             @db.Decimal(10, 2)
  subtotal       Decimal             @db.Decimal(10, 2)
  esPaquete      Boolean             @default(false)
  esSubProducto  Boolean             @default(false)
  paqueteId      Int?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  cotizacion     Cotizacion          @relation(fields: [cotizacionId], references: [id])
  detallePaquete DetalleCotizacion?  @relation("DetallesPaquete", fields: [paqueteId], references: [id])
  subDetalles    DetalleCotizacion[] @relation("DetallesPaquete")
  producto       Producto            @relation(fields: [productoId], references: [productoId])

  @@index([cotizacionId])
  @@index([productoId])
  @@index([paqueteId])
}

model Solicitud {
  id                   Int                  @id @default(autoincrement())
  fechaCreacion        DateTime             @default(now())
  clienteId            Int?
  obraId               Int?
  cotizacionId         Int?
  observaciones        String?
  numeroSolicitud      Int                  @unique @default(autoincrement())
  estadoOperativo      EstadoOperacional    @default(PENDIENTE)
  estadoAdministrativo EstadoAdministrativo @default(PENDIENTE)
  agendas              Agenda[]
  cliente              Cliente?             @relation(fields: [clienteId], references: [clienteId])
  cotizacion           Cotizacion?          @relation(fields: [cotizacionId], references: [id])
  obra                 Obra?                @relation(fields: [obraId], references: [obraId])

  @@map("solicitudes")
}

model Servicio {
  id          Int      @id @default(autoincrement())
  codigo      String   @unique
  nombre      String
  descripcion String?
  estado      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Equipo {
  id          Int            @id @default(autoincrement())
  codigo      String         @unique
  nombre      String
  descripcion String?
  estado      Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  agendas     AgendaEquipo[]
}

model Agenda {
  id              Int              @id @default(autoincrement())
  titulo          String
  tipoVisita      String
  esRecurrente    Boolean          @default(false)
  fechaInicio     DateTime
  fechaFin        DateTime
  estado          EstadoAgenda     @default(AGENDADA)
  clienteId       Int?
  obraId          Int?
  solicitudId     Int?
  observaciones   String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  comuna          String?
  direccion       String?
  referencia      String?
  region          String?
  sectorComercial String?
  horaLlegada     String?
  horaSalida      String?
  kmAdicionales   String?
  movilizacion    String?
  cliente         Cliente?         @relation(fields: [clienteId], references: [clienteId])
  obra            Obra?            @relation(fields: [obraId], references: [obraId])
  solicitud       Solicitud?       @relation(fields: [solicitudId], references: [id])
  asignados       AgendaAsignado[]
  equipos         AgendaEquipo[]
  servicios       AgendaServicio[]
  ordenesTrabajo  OrdenTrabajo[]
}

model AgendaServicio {
  id              Int     @id @default(autoincrement())
  agendaId        Int
  codigo          String
  servicio        String
  cantidad        Int
  observacion     String?
  esSegundaVisita Boolean @default(false)
  agenda          Agenda  @relation(fields: [agendaId], references: [id])
}

model AgendaAsignado {
  id          Int      @id @default(autoincrement())
  agendaId    Int
  userId      String
  esPrincipal Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  agenda      Agenda   @relation(fields: [agendaId], references: [id])
  user        User     @relation(fields: [userId], references: [id])

  @@unique([agendaId, userId])
}

model AgendaEquipo {
  id          Int      @id @default(autoincrement())
  agendaId    Int
  equipoId    Int
  cantidad    Int      @default(1)
  observacion String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  agenda      Agenda   @relation(fields: [agendaId], references: [id])
  equipo      Equipo   @relation(fields: [equipoId], references: [id])

  @@unique([agendaId, equipoId])
}

model Rol {
  id          Int       @id @default(autoincrement())
  nombre      String    @unique
  descripcion String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  usuarios    UserRol[]
}

model UserRol {
  id        Int      @id @default(autoincrement())
  userId    String
  rolId     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  rol       Rol      @relation(fields: [rolId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, rolId])
}

model OrdenTrabajo {
  id                  String               @id @default(cuid())
  clave               String               @unique
  estado              String
  origen              String
  fklbrutas           String
  correlativ          String
  fklbdocver          String
  fklbrutser          String
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  userId              String
  tipoOT              TipoOrdenTrabajo
  agendaId            Int?
  aceptacionVisita    AceptacionVisita?
  densidad            Densidad?
  extraccionAsfaltica ExtraccionAsfaltica?
  hormigonFresco      HormigonFresco?
  muestreoMaterial    MuestreoMaterial?
  agenda              Agenda?              @relation(fields: [agendaId], references: [id])
  user                User                 @relation(fields: [userId], references: [id])
  retiroProbeta       RetiroProbeta?
  testigos            Testigos?
}

model AceptacionVisita {
  id                  String       @id @default(cuid())
  ordenTrabajoId      String       @unique
  horaSalida          String?
  horaLlegada         String?
  movilizacion        String?
  emailNotificacion   String?
  nombrePersonaRecibe String?
  rutPersonaRecibe    String?
  gpsInicio           String?
  gpsFin              String?
  horainicio          DateTime?
  horafin             DateTime?
  ordenTrabajo        OrdenTrabajo @relation(fields: [ordenTrabajoId], references: [id])
}

model Densidad {
  id             String       @id @default(cuid())
  ordenTrabajoId String       @unique
  item           String?
  marca          String?
  modelo         String?
  controles      Json?
  codigoEquipo   String?
  descripSuelo   String?
  listaChequeo   Json?
  ordenTrabajo   OrdenTrabajo @relation(fields: [ordenTrabajoId], references: [id])
}

model HormigonFresco {
  id                    String       @id @default(cuid())
  ordenTrabajoId        String       @unique
  item                  String?
  clima                 String?
  tAmbiente             Float?
  tHormigon             Float?
  numTarjeta            String?
  tipoHormigon          String?
  volumenHormigon       Float?
  cantidadProbetas      Int?
  conoAsentamiento      Float?
  elementoHormigonado   String?
  ubicacionHormigonado  String?
  caracteristicasMezcla String?
  probetas              Json?
  ordenTrabajo          OrdenTrabajo @relation(fields: [ordenTrabajoId], references: [id])
}

model Testigos {
  id             String       @id @default(cuid())
  ordenTrabajoId String       @unique
  grado          String?
  diametro       String?
  itemTestigo    String?
  tipoTestigo    String?
  numeroTarjeta  String?
  fechaMuestreo  DateTime?
  tipoPavimento  String?
  controles      Json?
  ordenTrabajo   OrdenTrabajo @relation(fields: [ordenTrabajoId], references: [id])
}

model ExtraccionAsfaltica {
  id                 String       @id @default(cuid())
  ordenTrabajoId     String       @unique
  item               String?
  metodo             String?
  bitumen            Boolean?
  cubicidad          Boolean?
  granulometria      Boolean?
  fechaMuestreo      DateTime?
  procedenciaAsfalto String?
  controles          Json?
  ordenTrabajo       OrdenTrabajo @relation(fields: [ordenTrabajoId], references: [id])
}

model MuestreoMaterial {
  id             String       @id @default(cuid())
  ordenTrabajoId String       @unique
  controles      Json?
  obsServicio    String?
  ordenTrabajo   OrdenTrabajo @relation(fields: [ordenTrabajoId], references: [id])
}

model RetiroProbeta {
  id                  String       @id @default(cuid())
  ordenTrabajoId      String       @unique
  horaRetiro          String?
  numTarjeta          String?
  otMuestreo          String?
  fechaRetiro         DateTime?
  tempFinCurado       Float?
  formaTransporte     String?
  condicionAlRetirar  String?
  condicionTransporte String?
  ordenTrabajo        OrdenTrabajo @relation(fields: [ordenTrabajoId], references: [id])
}

model RCM {
  id                Int           @id @default(autoincrement())
  numeroRcm         String        @unique
  fechaCodificacion DateTime
  fechaMuestreo     DateTime
  fechaIngreso      DateTime
  estado            String        @default("ACTIVO")
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  clienteId         Int?
  obraId            Int?
  observaciones     String?
  muestras          Muestra[]
  cliente           Cliente?      @relation(fields: [clienteId], references: [clienteId])
  obra              Obra?         @relation(fields: [obraId], references: [obraId])
  servicios         ServicioRCM[]
}

model ServicioRCM {
  id         Int      @id @default(autoincrement())
  rcmId      Int
  productoId Int
  codigo     String
  nombre     String
  cantidad   Int
  estado     String   @default("CODIFICADO")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  producto   Producto @relation(fields: [productoId], references: [productoId])
  rcm        RCM      @relation(fields: [rcmId], references: [id])
}

model Muestra {
  id              Int               @id @default(autoincrement())
  rcmId           Int
  numeroMuestra   String            @unique
  tipoMaterial    String?
  elemento        String?
  item            String?
  grado           String?
  procedencia     String?
  cotas           String?
  ubicacionSector String?
  vencimiento     Boolean           @default(true)
  observaciones   String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  rcm             RCM               @relation(fields: [rcmId], references: [id])
  probetas        Probeta[]
  servicios       ServicioMuestra[]
}

model ServicioMuestra {
  id         Int      @id @default(autoincrement())
  muestraId  Int
  productoId Int
  codigo     String
  nombre     String
  cantidad   Int
  estado     String   @default("CODIFICADO")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  muestra    Muestra  @relation(fields: [muestraId], references: [id])
  producto   Producto @relation(fields: [productoId], references: [productoId])
}

model Probeta {
  id               Int      @id @default(autoincrement())
  muestraId        Int
  numero           Int
  fechaConfeccion  DateTime
  cantidad         Int
  dias             Int
  fechaVencimiento DateTime
  estado           String   @default("CODIFICADO")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  muestra          Muestra  @relation(fields: [muestraId], references: [id])
}

enum EstadoProducto {
  ACTIVO
  INACTIVO
}

enum TipoCotizacion {
  A
  B
  C
}

enum EstadoCotizacion {
  BORRADOR
  COTIZADA
  GESTIONADA
  ACEPTADA
  SIN_RESPUESTA
  RECHAZADA
}

enum EstadoOperacional {
  PENDIENTE
  EN_PROCESO
  FINALIZADO
  CANCELADO
}

enum EstadoAdministrativo {
  PENDIENTE
  APROBADO
  RECHAZADO
  EN_REVISION
}

enum EstadoAgenda {
  AGENDADA
  COMPLETADA
  SUSPENDIDA
  CANCELADA
  EN_PROCESO
}

enum TipoOrdenTrabajo {
  ACEPTACION_VISITA
  DENSIDADES
  HORMIGON_FRESCO
  TESTIGOS
  EXTRACCION_ASFALTICA
  MUESTREO_MATERIAL
  RETIRO_PROBETA
}
