generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Cliente {
  clienteId              Int                 @id @default(autoincrement())
  fechaCreacion          DateTime            @default(now())
  estado                 String
  rut                    String              @unique
  razonSocial            String
  nombreCliente          String
  pais                   String
  region                 String
  ciudad                 String
  comuna                 String
  direccion              String
  telefono               String?
  sitioWeb               String?
  segmento               String?
  industria              String?
  giro                   String?
  emailFacturacion       String[]
  otroRut                String?
  representanteLegal     String?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  agendas                Agenda[]
  clientesContactos      ClienteContacto[]
  condicionesComerciales CondicionComercial?
  cotizaciones           Cotizacion[]
  rcms                   RCM[]
  solicitudes            Solicitud[]
}

model Contacto {
  nombre            String
  email             String
  telefono1         String
  telefono2         String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  contactId         Int               @id @default(autoincrement())
  comuna            String?
  direccion         String?
  empresa           String?
  cargo             String            @default("Sin cargo")
  estado            String            @default("ACTIVO")
  clientesContactos ClienteContacto[]
  contactosObra     ContactoObra[]
  Cotizacion        Cotizacion[]
  contactosAgenda   ContactoAgenda[]
}

model CondicionComercial {
  id             Int     @id @default(autoincrement())
  vendedor       String
  condicionVenta String
  observaciones  String?
  clienteId      Int     @unique
  cliente        Cliente @relation(fields: [clienteId], references: [clienteId])
}

model User {
  id               String           @id @default(cuid())
  name             String?
  email            String?          @unique
  password         String?
  emailVerified    DateTime?
  image            String?
  rut              String?
  usuario          String?
  activo           String           @default("ACTIVO")
  accounts         Account[]
  agendas          AgendaAsignado[]
  ordenesTrabajo   OrdenTrabajo[]
  sessions         Session[]
  roles            UserRol[]
  equiposAsignados Equipo[]         @relation("EquiposFuncionario")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ClienteContacto {
  id          Int      @id @default(autoincrement())
  clienteId   Int
  contactId   Int
  cargo       String
  nombre      String   @default("")
  email       String   @default("")
  telefono1   String   @default("")
  telefono2   String?
  isPrincipal Boolean  @default(false)
  createdAt   DateTime @default(now())
  cliente     Cliente  @relation(fields: [clienteId], references: [clienteId])
  contacto    Contacto @relation(fields: [contactId], references: [contactId])

  @@unique([clienteId, contactId])
}

model Producto {
  productoId              Int                      @id @default(autoincrement())
  sku                     String                   @unique
  nombre                  String
  descripcion             String?
  area                    String?
  familia                 String?
  esPaquete               Boolean                  @default(false)
  tipo                    String
  precio                  Decimal?                 @db.Decimal(10, 3)
  estado                  EstadoProducto           @default(ACTIVO)
  norma                   String?
  aplicaImpuesto          Boolean                  @default(true)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  detallesCotizacion      DetalleCotizacion[]
  listasPrecios           ProductoListaPrecio[]
  productosEnPaquete      ProductoPaquete[]        @relation("PaqueteProductos")
  paquetesQueLoIncluyen   ProductoPaquete[]        @relation("ProductoEnPaquetes")
  serviciosMuestra        ServicioMuestra[]
  serviciosRCM            ServicioRCM[]
  subProductosServicioRCM SubProductoServicioRCM[]
  codigoAgrupadorEnsayos  CodigoAgrupadorEnsayo[]

  @@index([sku])
  @@index([estado])
  @@index([familia])
  @@index([area])
}

model ProductoPaquete {
  id             Int      @id @default(autoincrement())
  paqueteId      Int
  productoId     Int
  cantidad       Int      @default(1)
  descripcion    String?
  precioUnitario Decimal? @db.Decimal(10, 3)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  paquete        Producto @relation("PaqueteProductos", fields: [paqueteId], references: [productoId])
  producto       Producto @relation("ProductoEnPaquetes", fields: [productoId], references: [productoId])

  @@unique([paqueteId, productoId])
  @@index([paqueteId])
  @@index([productoId])
}

model Obra {
  obraId                   Int            @id @default(autoincrement())
  numeroObra               String
  fechaIngreso             DateTime
  estado                   String         @default("activo")
  estadoObra               String
  rut                      String
  nombreCliente            String
  razonSocial              String?
  nombreObra               String
  direccion                String
  region                   String
  comuna                   String
  sector                   String?
  georreferencia           String?
  referencia               String?
  mandante                 String?
  informeMandante          Boolean        @default(false)
  textoMandante            String?
  giro                     String?
  direccionComercial       String?
  comunaFacturacion        String?
  telefonoFacturacion      String?
  listaPrecios             String?
  mailRecepcionFactura     String[]
  correos                  String[]
  acreditacionPersonal     Boolean        @default(false)
  especificacionesTecnicas Boolean        @default(false)
  acreditacionEquipos      Boolean        @default(false)
  cartaCompromiso          Boolean        @default(false)
  mandatoServiu            Boolean        @default(false)
  otrosRequisitos          String?
  estadoPago               Boolean        @default(false)
  hes                      Boolean        @default(false)
  oc                       Boolean        @default(false)
  otrasReferencias         String?
  envioInformes            Boolean        @default(false)
  representanteLegal       String?
  rutRepresentanteLegal    String?
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt
  agendas                  Agenda[]
  contactos                ContactoObra[]
  cotizaciones             Cotizacion[]
  rcms                     RCM[]
  solicitudes              Solicitud[]
}

model ContactoObra {
  id          Int       @id @default(autoincrement())
  nombre      String
  rol         String
  email       String?
  telefono1   String?
  telefono2   String?
  isPrincipal Boolean   @default(false)
  obraId      Int
  contactId   Int?
  contacto    Contacto? @relation(fields: [contactId], references: [contactId])
  obra        Obra      @relation(fields: [obraId], references: [obraId])
}

model Permission {
  id          String       @id @default(cuid())
  name        String       @unique
  assignedTo  String[] // ✅ MANTENER (prod_hito1_temp lo usa)
  descripcion String? // ✅ NUEVO campo opcional
  categoria   String? // ✅ NUEVO campo opcional
  createdDate DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  roles       RolPermiso[] // ✅ NUEVA relación (no afecta lo anterior)
}

model Region {
  id        Int      @id @default(autoincrement())
  codigo    String   @unique
  nombre    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  comunas   Comuna[]
}

model Comuna {
  id        Int      @id @default(autoincrement())
  codigo    String   @unique
  nombre    String
  regionId  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  region    Region   @relation(fields: [regionId], references: [id])

  @@index([regionId])
}

model ListaPrecio {
  id           Int                   @id @default(autoincrement())
  nombre       String
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  productos    ProductoListaPrecio[]
  cotizaciones Cotizacion[]
}

model ProductoListaPrecio {
  id            Int         @id @default(autoincrement())
  productoId    Int
  listaPrecioId Int
  precio        Decimal?    @db.Decimal(10, 3)
  activo        Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  listaPrecio   ListaPrecio @relation(fields: [listaPrecioId], references: [id])
  producto      Producto    @relation(fields: [productoId], references: [productoId])

  @@unique([productoId, listaPrecioId])
}

model Cotizacion {
  id                  Int                 @id @default(autoincrement())
  numeroCotizacion    String
  tipoCotizacion      TipoCotizacion      @default(A)
  fechaCreacion       DateTime            @default(now())
  fechaInicio         DateTime
  fechaFin            DateTime
  estado              EstadoCotizacion    @default(BORRADOR)
  nombreProyecto      String?
  empresa             String?
  ubicacion           String?
  clienteId           Int?
  obraId              Int?
  vendedorId          String?
  observaciones       String?
  observacionGestion  String?
  notas               String?
  textoGeneral        String?
  version             String?
  subtotal            Decimal             @db.Decimal(10, 3)
  descuento           Decimal             @db.Decimal(10, 3)
  impuesto            Decimal             @db.Decimal(10, 3)
  total               Decimal             @db.Decimal(10, 3)
  contactId           Int?
  listaPrecioId       Int?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  formaPago           String?
  superficieEMS       String?
  antecedentesEMS     String?
  plazoEntregaEMS     String?
  duracionMensual     String?
  jornadaMensual      String?
  antecedentesMensual String?
  alcanceServicio     String?
  antecedentesGeneral String?
  plazoEntregaGeneral String?
  sinCantidad         Boolean?
  precioProducto      Boolean?
  precioTotal         Boolean?
  cliente             Cliente?            @relation(fields: [clienteId], references: [clienteId])
  contacto            Contacto?           @relation(fields: [contactId], references: [contactId], map: "Cotizacion_contactoId_fkey")
  obra                Obra?               @relation(fields: [obraId], references: [obraId])
  listaPrecio         ListaPrecio?        @relation(fields: [listaPrecioId], references: [id])
  detalles            DetalleCotizacion[]
  solicitudes         Solicitud[]

  @@index([contactId], map: "Cotizacion_contactoId_idx")
  @@index([listaPrecioId])
}

model DetalleCotizacion {
  id                       Int                 @id @default(autoincrement())
  cotizacionId             Int
  productoId               Int
  cantidad                 Int
  precioUnitario           Decimal             @db.Decimal(10, 3)
  descuento                Decimal             @db.Decimal(10, 3)
  subtotal                 Decimal             @db.Decimal(10, 3)
  esPaquete                Boolean             @default(false)
  esSubProducto            Boolean             @default(false)
  paqueteId                Int?
  descripcionPersonalizada String?
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt
  cotizacion               Cotizacion          @relation(fields: [cotizacionId], references: [id])
  detallePaquete           DetalleCotizacion?  @relation("DetallesPaquete", fields: [paqueteId], references: [id])
  subDetalles              DetalleCotizacion[] @relation("DetallesPaquete")
  producto                 Producto            @relation(fields: [productoId], references: [productoId])

  @@index([cotizacionId])
  @@index([productoId])
  @@index([paqueteId])
}

model Solicitud {
  id                   Int                  @id @default(autoincrement())
  fechaCreacion        DateTime             @default(now())
  clienteId            Int?
  obraId               Int?
  cotizacionId         Int?
  observaciones        String?
  numeroSolicitud      Int                  @unique @default(autoincrement())
  estadoOperativo      EstadoOperacional    @default(PENDIENTE)
  estadoAdministrativo EstadoAdministrativo @default(PENDIENTE)
  agendas              Agenda[]
  cliente              Cliente?             @relation(fields: [clienteId], references: [clienteId])
  cotizacion           Cotizacion?          @relation(fields: [cotizacionId], references: [id])
  obra                 Obra?                @relation(fields: [obraId], references: [obraId])

  @@map("solicitudes")
}

model Servicio {
  id          Int      @id @default(autoincrement())
  codigo      String   @unique
  nombre      String
  descripcion String?
  estado      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Equipo {
  id                    Int                 @id @default(autoincrement())
  codigo                String              @unique
  nombre                String
  tipoEquipoId          Int
  descripcion           String?
  serie                 String?
  funcionarioAsignadoId String?
  areaId                Int?
  estado                String              @default("Activo")
  observaciones         String?
  marca                 String?
  modelo                String?
  agenda                Boolean?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  tipoEquipo            TipoEquipo          @relation(fields: [tipoEquipoId], references: [id])
  funcionarioAsignado   User?               @relation("EquiposFuncionario", fields: [funcionarioAsignadoId], references: [id])
  area                  Area?               @relation(fields: [areaId], references: [id])
  agendas               AgendaEquipo[]
  calibraciones         CalibracionEquipo[]

  @@index([tipoEquipoId])
  @@index([funcionarioAsignadoId])
  @@index([areaId])
}

model TipoEquipo {
  id      Int      @id @default(autoincrement())
  tipo    String   @unique
  equipos Equipo[]
}

model Agenda {
  id                        Int               @id @default(autoincrement())
  titulo                    String
  tipoVisita                String
  esRecurrente              Boolean           @default(false)
  fechaInicio               DateTime
  fechaFin                  DateTime
  estado                    EstadoAgenda      @default(CREADA)
  clienteId                 Int?
  obraId                    Int?
  solicitudId               Int?
  observaciones             String?
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt
  comuna                    String?
  direccion                 String?
  referencia                String?
  georreferencia            String?
  region                    String?
  sectorComercial           String?
  horaLlegada               String?
  horaSalida                String?
  kmAdicionales             String?
  movilizacion              String?
  observacionEliminada      String?
  observacionSuspendida     String?
  observacionEnRevision     String?
  observacionAnulada        String?
  observacionRecibidaOK     String?
  observacionComprobante    String?
  observacionAgendada       String?
  observacionAnuladaGeneral String?
  comprobanteVisitaJSON     Json?
  motivoSuspension          MotivoSuspension?
  cliente                   Cliente?          @relation(fields: [clienteId], references: [clienteId])
  obra                      Obra?             @relation(fields: [obraId], references: [obraId])
  solicitud                 Solicitud?        @relation(fields: [solicitudId], references: [id])
  asignados                 AgendaAsignado[]
  equipos                   AgendaEquipo[]
  servicios                 AgendaServicio[]
  ordenesTrabajo            OrdenTrabajo[]
  contactos                 ContactoAgenda[]
}

model ContactoAgenda {
  id          Int       @id @default(autoincrement())
  nombre      String
  rol         String
  email       String?
  telefono1   String?
  telefono2   String?
  isPrincipal Boolean   @default(false)
  agendaId    Int
  contactId   Int?
  contacto    Contacto? @relation(fields: [contactId], references: [contactId])
  agenda      Agenda    @relation(fields: [agendaId], references: [id])
}

model AgendaServicio {
  id              Int     @id @default(autoincrement())
  agendaId        Int
  codigo          String
  servicio        String
  cantidad        Int
  observacion     String?
  esSegundaVisita Boolean @default(false)
  agenda          Agenda  @relation(fields: [agendaId], references: [id])
}

model AgendaAsignado {
  id          Int      @id @default(autoincrement())
  agendaId    Int
  userId      String
  esPrincipal Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  agenda      Agenda   @relation(fields: [agendaId], references: [id])
  user        User     @relation(fields: [userId], references: [id])

  @@unique([agendaId, userId])
}

model AgendaEquipo {
  id          Int      @id @default(autoincrement())
  agendaId    Int
  equipoId    Int
  cantidad    Int      @default(1)
  observacion String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  agenda      Agenda   @relation(fields: [agendaId], references: [id])
  equipo      Equipo   @relation(fields: [equipoId], references: [id])

  @@unique([agendaId, equipoId])
}

model Rol {
  id          Int          @id @default(autoincrement())
  nombre      String       @unique
  descripcion String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  usuarios    UserRol[]
  permisos    RolPermiso[] // ✅ NUEVA relación (no afecta lo anterior)
}

// ✅ NUEVA TABLA (no toca nada existente)
model RolPermiso {
  id           Int        @id @default(autoincrement())
  rolId        Int
  permissionId String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  rol          Rol        @relation(fields: [rolId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([rolId, permissionId])
  @@index([rolId])
  @@index([permissionId])
}

model UserRol {
  id        Int      @id @default(autoincrement())
  userId    String
  rolId     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  rol       Rol      @relation(fields: [rolId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, rolId])
}

model OrdenTrabajo {
  id                  String               @id @default(cuid())
  clave               String               @unique
  estado              String
  origen              String
  fklbrutas           String
  correlativ          String
  fklbdocver          String
  fklbrutser          String
  numeroTarjeta       String[]             @default([])
  numeroCorrelativo   Int?                 @unique
  jsonOT              Json?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  userId              String
  tipoOrdenTrabajoId  Int
  agendaId            Int?
  estadoOTId          Int?
  aceptacionVisita    AceptacionVisita?
  densidad            Densidad?
  extraccionAsfaltica ExtraccionAsfaltica?
  hormigonFresco      HormigonFresco?
  muestreoMaterial    MuestreoMaterial?
  agenda              Agenda?              @relation(fields: [agendaId], references: [id])
  user                User                 @relation(fields: [userId], references: [id])
  tipoOT              TipoOrdenTrabajo     @relation(fields: [tipoOrdenTrabajoId], references: [id])
  estadoOT            EstadoOT?            @relation(fields: [estadoOTId], references: [id])
  retiroProbeta       RetiroProbeta?
  testigos            Testigos?
  RCM                 RCM[]
  codigosAgrupadores  CodigoAgrupador[]

  @@index([tipoOrdenTrabajoId])
  @@index([estadoOTId])
}

model AceptacionVisita {
  id                  String       @id @default(cuid())
  ordenTrabajoId      String       @unique
  horaSalida          String?
  horaLlegada         String?
  movilizacion        String?
  emailNotificacion   String?
  nombrePersonaRecibe String?
  rutPersonaRecibe    String?
  gpsInicio           String?
  gpsFin              String?
  horainicio          DateTime?
  horafin             DateTime?
  ordenTrabajo        OrdenTrabajo @relation(fields: [ordenTrabajoId], references: [id])
}

model Densidad {
  id             String       @id @default(cuid())
  ordenTrabajoId String       @unique
  item           String?
  marca          String?
  modelo         String?
  controles      Json?
  codigoEquipo   String?
  descripSuelo   String?
  listaChequeo   Json?
  ordenTrabajo   OrdenTrabajo @relation(fields: [ordenTrabajoId], references: [id])
}

model HormigonFresco {
  id                    String       @id @default(cuid())
  ordenTrabajoId        String       @unique
  item                  String?
  clima                 String?
  tAmbiente             Float?
  tHormigon             Float?
  numTarjeta            String?
  tipoHormigon          String?
  volumenHormigon       Float?
  cantidadProbetas      Int?
  conoAsentamiento      Float?
  elementoHormigonado   String?
  ubicacionHormigonado  String?
  caracteristicasMezcla String?
  probetas              Json?
  ordenTrabajo          OrdenTrabajo @relation(fields: [ordenTrabajoId], references: [id])
}

model Testigos {
  id             String       @id @default(cuid())
  ordenTrabajoId String       @unique
  grado          String?
  diametro       String?
  itemTestigo    String?
  tipoTestigo    String?
  numeroTarjeta  String?
  fechaMuestreo  DateTime?
  tipoPavimento  String?
  controles      Json?
  ordenTrabajo   OrdenTrabajo @relation(fields: [ordenTrabajoId], references: [id])
}

model ExtraccionAsfaltica {
  id                 String       @id @default(cuid())
  ordenTrabajoId     String       @unique
  item               String?
  metodo             String?
  bitumen            Boolean?
  cubicidad          Boolean?
  granulometria      Boolean?
  fechaMuestreo      DateTime?
  procedenciaAsfalto String?
  controles          Json?
  ordenTrabajo       OrdenTrabajo @relation(fields: [ordenTrabajoId], references: [id])
}

model MuestreoMaterial {
  id             String       @id @default(cuid())
  ordenTrabajoId String       @unique
  controles      Json?
  obsServicio    String?
  ordenTrabajo   OrdenTrabajo @relation(fields: [ordenTrabajoId], references: [id])
}

model RetiroProbeta {
  id                  String       @id @default(cuid())
  ordenTrabajoId      String       @unique
  horaRetiro          String?
  numTarjeta          String?
  otMuestreo          String?
  fechaRetiro         DateTime?
  tempFinCurado       Float?
  formaTransporte     String?
  condicionAlRetirar  String?
  condicionTransporte String?
  ordenTrabajo        OrdenTrabajo @relation(fields: [ordenTrabajoId], references: [id])
}

model RCM {
  id                   Int              @id @default(autoincrement())
  numeroRcm            String           @unique
  fechaCodificacion    DateTime
  fechaMuestreo        DateTime
  fechaIngreso         DateTime
  fechaEntrega         DateTime?
  estadoOperativo      String?          @map("estado_operativo")
  estadoAdministrativo String?          @map("estado_administrativo")
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  clienteId            Int?
  obraId               Int?             @map("obraId")
  ordenTrabajoId       String?          @map("ordenTrabajoId")
  observaciones        String?
  // Campos del Control Interno
  rcmType              String? // 'Muestra' | 'Control' | 'Servicio'
  sede                 String?
  areaId               Int?
  familiaId            Int?
  numeroTarjeta        String?
  tipoMaterial         String?
  item                 String?
  procedencia          String?
  ubicacionSector      String?
  grado                String?
  elemento             String?
  cantidadMuestras     Int?
  vencimiento          Boolean          @default(false)
  fechaServicio        DateTime?
  fechaConfeccion      DateTime?
  tomaMuestra          String?
  codigoProducto       String?
  informeEnsayo        Boolean          @default(true)
  observacionItem      String?
  cota1                String?
  cota2                String?
  codigoAgrupadorId    Int?
  // Relaciones
  muestras             Muestra[]
  cliente              Cliente?         @relation(fields: [clienteId], references: [clienteId])
  obra                 Obra?            @relation(fields: [obraId], references: [obraId])
  ordenTrabajo         OrdenTrabajo?    @relation(fields: [ordenTrabajoId], references: [id])
  area                 Area?            @relation(fields: [areaId], references: [id])
  familia              Familia?         @relation(fields: [familiaId], references: [id])
  codigoAgrupador      CodigoAgrupador? @relation(fields: [codigoAgrupadorId], references: [id])
  codigoAgrupadorLinks CodigoAgrupadorRcm[]
  servicios            ServicioRCM[]
  RCMHistory           RCMHistory[]

  @@index([areaId])
  @@index([familiaId])
  @@index([codigoAgrupadorId])
  @@index([ordenTrabajoId])
}

model ServicioRCM {
  id              Int                      @id @default(autoincrement())
  rcmId           Int
  productoId      Int
  codigo          String
  nombre          String
  cantidad        Int
  estado          String                   @default("CODIFICADO")
  norma           String?
  observacion     String?
  estadoOperativo String?
  esPaquete       Boolean                  @default(false)
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  producto        Producto                 @relation(fields: [productoId], references: [productoId])
  rcm             RCM                      @relation(fields: [rcmId], references: [id])
  subProductos    SubProductoServicioRCM[]
}

model Muestra {
  id               Int               @id @default(autoincrement())
  rcmId            Int
  numeroMuestra    String            @unique
  numeroTarjeta    String?
  tipoMaterial     String?
  elemento         String?
  item             String?
  grado            String?
  procedencia      String?
  cotas            String?
  ubicacionSector  String?
  vencimiento      Boolean           @default(true)
  observaciones    String?
  cantidadMuestras Int?
  estadoMuestra    String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  rcm              RCM               @relation(fields: [rcmId], references: [id])
  probetas         Probeta[]
  servicios        ServicioMuestra[]
}

model ServicioMuestra {
  id         Int                        @id @default(autoincrement())
  muestraId  Int
  productoId Int
  codigo     String
  nombre     String
  cantidad   Int
  estado     String                     @default("CODIFICADO")
  createdAt  DateTime                   @default(now())
  updatedAt  DateTime                   @updatedAt
  muestra    Muestra                    @relation(fields: [muestraId], references: [id])
  producto   Producto                   @relation(fields: [productoId], references: [productoId])
  history    ServicioMuestraHistorial[]
}

model Probeta {
  id               Int      @id @default(autoincrement())
  muestraId        Int
  numero           Int
  fechaConfeccion  DateTime
  cantidad         Int
  dias             Int
  fechaVencimiento DateTime
  estado           String   @default("CODIFICADO")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  muestra          Muestra  @relation(fields: [muestraId], references: [id])
}

model Area {
  id         Int             @id @default(autoincrement())
  nombre     String          @unique
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  familias   Familia[]
  equipos    Equipo[]
  rcms       RCM[]
  parametros ParametroArea[]
}

model ParametroArea {
  id          Int      @id @default(autoincrement())
  areaId      Int
  tipo        String // MATERIAL, ITEM, GRADO
  descripcion String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  area        Area     @relation(fields: [areaId], references: [id])

  @@unique([areaId, tipo, descripcion])
  @@index([areaId, tipo])
}

model Familia {
  id        Int      @id @default(autoincrement())
  nombre    String
  areaId    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  area      Area     @relation(fields: [areaId], references: [id])
  rcms      RCM[]

  @@unique([nombre, areaId])
  @@index([areaId])
}

enum EstadoProducto {
  ACTIVO
  INACTIVO
}

enum TipoCotizacion {
  A
  B
  C
  D
}

enum EstadoCotizacion {
  BORRADOR
  COTIZADA
  GESTIONADA
  ACEPTADA
  SIN_RESPUESTA
  RECHAZADA
}

enum EstadoOperacional {
  PENDIENTE
  EN_PROCESO
  FINALIZADO
  CANCELADO
}

enum EstadoAdministrativo {
  PENDIENTE
  APROBADO
  RECHAZADO
  EN_REVISION
}

enum EstadoAgenda {
  CREADA
  ELIMINADA
  AGENDADA
  SUSPENDIDA
  SUSPENDIDA_TERRENO
  COMPLETADA
  EN_REVISION
  ANULADA
  RECIBIDA_OK
  CODIFICADA
}

enum MotivoSuspension {
  CLIMA
  TERRENO_NO_PREPARADO
  PROBLEMA_PLANTA
  PROBLEMA_INTERNO_PA
  ACREDITACION_PERSONAL
  OTRO
}

model TipoOrdenTrabajo {
  id          Int            @id @default(autoincrement())
  codigo      String?
  descripcion String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  ordenes     OrdenTrabajo[]
}

model EstadoOT {
  id             Int            @id @default(autoincrement())
  origen         String?
  tipoJSON       String?
  estado         String?
  ordenesTrabajo OrdenTrabajo[]
}

model RCMHistory {
  id          Int       @id @default(autoincrement())
  rcmId       Int
  rcm         RCM       @relation(fields: [rcmId], references: [id])
  tipo        String // 'Ope' | 'Adm'
  funcionario String?
  estAnterior String?
  estNuevo    String
  informe     Int?
  fechaAccion DateTime?
  observacion String?
  createdAt   DateTime  @default(now())
  aplicadoA   String?
  tipoEstado  String?   @map("tipo_estado")
  motivo      String?   @map("motivo")

  @@index([rcmId])
}

model ServicioMuestraHistorial {
  id Int @id @default(autoincrement())

  // Relación con ServicioMuestra
  servicioMuestraId Int
  servicioMuestra   ServicioMuestra @relation(fields: [servicioMuestraId], references: [id], onDelete: Cascade)

  // Campos del historial
  registro          DateTime  @default(now())
  funcionario       String?
  aplicadoA         String?
  ensayoServicio    String?
  tipo              String?
  estAnterior       String?
  estNuevo          String?
  fechaAccion       DateTime  @default(now())
  fechaInicioEnsayo DateTime?
  fechaFinEnsayo    DateTime?
  observacion       String?   @db.Text
  motivo            String?   @db.Text
  informe           Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([servicioMuestraId])
  @@index([fechaAccion])
  @@index([tipo])
  @@map("ServicioMuestraHistorial")
}

model CalibracionEquipo {
  id               Int                  @id @default(autoincrement())
  fechaCalibracion DateTime
  certificado      String
  equipoId         Int?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  equipo           Equipo?              @relation(fields: [equipoId], references: [id])
  detalles         DetalleCalibracion[]

  @@index([equipoId])
}

model DetalleCalibracion {
  id                  Int               @id @default(autoincrement())
  datoEquipo          String
  correccion          String
  calibracionEquipoId Int
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  calibracionEquipo   CalibracionEquipo @relation(fields: [calibracionEquipoId], references: [id], onDelete: Cascade)

  @@index([calibracionEquipoId])
}

model SubProductoServicioRCM {
  id            Int         @id @default(autoincrement())
  servicioRcmId Int
  productoId    Int
  sku           String
  nombre        String
  norma         String?
  cantidad      Int         @default(1)
  observacion   String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  servicioRcm   ServicioRCM @relation(fields: [servicioRcmId], references: [id], onDelete: Cascade)
  producto      Producto    @relation(fields: [productoId], references: [productoId])

  @@index([servicioRcmId])
  @@index([productoId])
}

model CodigoAgrupador {
  id                  Int                     @id @default(autoincrement())
  codigoId            String                  @unique
  codigoNombre        String
  descripcionServicio String?
  notasInternas       String?
  cantidad            Int                     @default(1)
  unidad              String                  @default("unid")
  facturacion         String                  @default("Unitario")
  ordenTrabajoId      String?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  ordenTrabajo        OrdenTrabajo?           @relation(fields: [ordenTrabajoId], references: [id])
  rcms                RCM[]
  rcmLinks            CodigoAgrupadorRcm[]
  ensayos             CodigoAgrupadorEnsayo[]

  @@index([ordenTrabajoId])
}

model CodigoAgrupadorRcm {
  id                Int             @id @default(autoincrement())
  codigoAgrupadorId Int
  rcmId             Int
  createdAt         DateTime        @default(now())
  codigoAgrupador   CodigoAgrupador @relation(fields: [codigoAgrupadorId], references: [id], onDelete: Cascade)
  rcm               RCM             @relation(fields: [rcmId], references: [id], onDelete: Cascade)

  @@unique([codigoAgrupadorId, rcmId])
  @@index([codigoAgrupadorId])
  @@index([rcmId])
}

model CodigoAgrupadorEnsayo {
  id                Int             @id @default(autoincrement())
  codigoAgrupadorId Int
  productoId        Int
  sku               String
  nombre            String
  createdAt         DateTime        @default(now())
  codigoAgrupador   CodigoAgrupador @relation(fields: [codigoAgrupadorId], references: [id], onDelete: Cascade)
  producto          Producto        @relation(fields: [productoId], references: [productoId])

  @@index([codigoAgrupadorId])
  @@index([productoId])
}

model OTCorrelativoCounter {
  id        Int      @id @default(1)
  nextValue Int      @default(0)
  updatedAt DateTime @updatedAt
}
