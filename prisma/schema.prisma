generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Cliente {
  clienteId              Int                 @id @default(autoincrement())
  fechaCreacion          DateTime            @default(now())
  estado                 String
  rut                    String              @unique
  razonSocial            String
  nombreCliente          String
  pais                   String
  region                 String
  ciudad                 String
  comuna                 String
  direccion              String
  telefono               String?
  sitioWeb               String?
  segmento               String?
  industria              String?
  clientesContactos      ClienteContacto[]
  condicionesComerciales CondicionComercial?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
}

model Contacto {
  contactId   Int      @id @default(autoincrement())
  nombre      String
  cargo       String
  email       String
  telefono1   String
  telefono2   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  clientesContactos ClienteContacto[]
}

model CondicionComercial {
  id             Int     @id @default(autoincrement())
  vendedor       String
  condicionVenta String
  observaciones  String?
  clienteId      Int     @unique
  cliente        Cliente @relation(fields: [clienteId], references: [clienteId])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  password      String?
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Tabla de unión para la relación many-to-many
model ClienteContacto {
  id          Int      @id @default(autoincrement())
  clienteId   Int      // Referencia a Cliente.clienteId
  contactId   Int      // Referencia a Contacto.contactId
  isPrincipal Boolean  @default(false)
  createdAt   DateTime @default(now())
  cliente     Cliente  @relation(fields: [clienteId], references: [clienteId])
  contacto    Contacto @relation(fields: [contactId], references: [contactId])

  @@unique([clienteId, contactId])
}

// Tabla de ejemplo con buenas prácticas
model Producto {
  productoId    Int            @id @default(autoincrement())
  sku           String         @unique
  nombre        String
  descripcion   String?
  area          String         // ÁREA del ensayo/servicio
  familia       String         // FAMILIA del ensayo/servicio
  esPaquete     Boolean        @default(false)
  tipo          String         // TIPO de ensayo/servicio
  precio        Decimal        @db.Decimal(10, 2)
  estado        EstadoProducto @default(ACTIVO)
  norma         String?        // Para paquetes
  listaPrecios  String?        // Para paquetes
  aplicaImpuesto Boolean       @default(true)

  // Campos de auditoría
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  // Relaciones para paquetes
  productosEnPaquete ProductoPaquete[] @relation("PaqueteProductos")
  paquetesQueLoIncluyen ProductoPaquete[] @relation("ProductoEnPaquetes")

  // Índices para optimizar búsquedas frecuentes
  @@index([sku])
  @@index([estado])
  @@index([familia])
  @@index([area])
}

// Tabla para manejar la relación entre productos y paquetes
model ProductoPaquete {
  id          Int      @id @default(autoincrement())
  paqueteId   Int      // ID del producto que es paquete
  productoId  Int      // ID del producto incluido en el paquete
  createdAt   DateTime @default(now())
  paquete     Producto @relation("PaqueteProductos", fields: [paqueteId], references: [productoId])
  producto    Producto @relation("ProductoEnPaquetes", fields: [productoId], references: [productoId])

  @@unique([paqueteId, productoId])
}

enum EstadoProducto {
  ACTIVO
  INACTIVO
}

model Obra {
  obraId                    Int      @id @default(autoincrement())
  fechaCreacion            DateTime @default(now())
  numeroObra               String   @unique
  fechaIngreso             DateTime
  estado                   String
  estadoObra               String
  nombreObra               String
  direccion                String
  region                   String
  comuna                   String
  telefono                 String?
  sitioWeb                 String?

  // Datos del mandante
  informeMandante          Boolean  @default(false)
  textoMandante           String?

  // Requisitos
  acreditacionPersonal     Boolean  @default(false)
  especificacionesTecnicas Boolean  @default(false)
  acreditacionEquipos      Boolean  @default(false)
  cartaCompromiso          Boolean  @default(false)
  mandatoServiu            Boolean  @default(false)
  otrosRequisitos          String?

  // Facturación
  razonSocial             String
  rut                     String
  giro                    String
  direccionComercial      String
  comunaFacturacion       String
  telefonoFacturacion     String
  listaPrecios            String
  mailRecepcionFactura    String

  // Referencias
  estadoPago              Boolean  @default(false)
  hes                     Boolean  @default(false)
  oc                      Boolean  @default(false)
  otrasReferencias        String?

  // Relaciones
  contactos               ContactoObra[]
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  sector          String?
  georreferencia  String?
  referencia      String?
  mandante        String?
  nombreCliente   String
}

model ContactoObra {
  id          Int      @id @default(autoincrement())
  obraId      Int
  obra        Obra     @relation(fields: [obraId], references: [obraId])
  nombre      String
  cargo       String
  email       String
  telefono1   String
  telefono2   String?
  isPrincipal Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Permission {
  id          String   @id @default(cuid())
  name        String   @unique
  assignedTo  String[] // Almacenará los roles asignados
  createdDate DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
